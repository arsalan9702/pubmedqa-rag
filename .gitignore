# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# uv / virtual environment
.venv/
# NOTE: uv.lock is intentionally NOT ignored — commit it for reproducibility

# Environment variables / secrets
.env
*.key

# Data (large / regenerable — keep raw & processed data out of git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Vector store persisted files
data/processed/vector_store/

# Model checkpoints
src/reranker/checkpoints/
*.pt
*.bin
*.safetensors

# Jupyter / Colab
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Streamlit
.streamlit/